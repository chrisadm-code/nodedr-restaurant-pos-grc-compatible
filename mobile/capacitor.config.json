{
  "appId": "com.nodedr.orderrestro",
  "appName": "OrderRestro",
  "webDir": "www",
  "backgroundColor": "#ffffff",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": ["localhost", "127.0.0.1"]
  },
  "android": { "allowMixedContent": true },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#9f1239", "showSpinner": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "Keyboard": { "resize": "body" }
  }
}
